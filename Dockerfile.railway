FROM python:3.12-slim

WORKDIR /app

# Install uv from official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Install CPU-only torch first to avoid pulling CUDA packages (~2.5GB)
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu --no-cache-dir

# Copy dependency files and install
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY movie_assistant/ movie_assistant/
COPY streamlit_app.py .
COPY data/movies_clean.csv data/movies_clean.csv
COPY data/faiss_index_all-MiniLM-L6-v2.bin data/faiss_index_all-MiniLM-L6-v2.bin

EXPOSE 8501

ENV PYTHONUNBUFFERED=1

HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health || exit 1

ENTRYPOINT ["uv", "run", "streamlit", "run", "streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
